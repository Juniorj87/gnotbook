# Copy this file to .env. Never store a wallet seed phrase or private key here.
PORT=4173
NODE_ENV=development

# Public Gno.land RPC. Mainnet is read-only by default.
GNOLAND_RPC_URL=https://rpc.gno.land:443
GNOLAND_CHAIN_ID=gnoland-1
GNOLAND_MAINNET_TRADING_ENABLED=false
# Optional Onyx testnet configuration (use the corresponding RPC when testing there).
# GNOLAND_RPC_URL=https://rpc.onyx.testnets.gno.land:443
# GNOLAND_CHAIN_ID=onyx-1
GNOLAND_ONYX_TRADING_ENABLED=false

# A PUBLIC wallet address receiving Morrow marketplace fees. Never put a private key here.
MORROW_TREASURY_ADDRESS=
# Founder reserve: editions minted to this public address when a fixed-edition collection launches.
# Must be an explicit public wallet address; it never falls back to the treasury. Set reserve to 0 to disable.
MORROW_FOUNDER_ADDRESS=
MORROW_FOUNDER_RESERVE=333
# Set after deploying contracts/registry/morrowmarket.gno from Creator Studio.
MORROW_REGISTRY_PATH=
# Fixed in the on-chain collection contract at 250 basis points (2.5%).
# The backend intentionally accepts only 250; changing this value does not change contract rules.
MARKETPLACE_FEE_BPS=250

# Pinata API JWT, server side only. Needs permission to pin files to IPFS.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
MAX_UPLOAD_MB=15
MAX_UPLOADS_PER_DAY=100

# Octopin API keys for IPFS pinning. Keep these only in local .env; never commit or ship them.
# Assign separate collection uploads to the two accounts to stay within each account's quota.
OCTOPIN_API_KEY=
OCTOPIN_API_KEY_1=
OCTOPIN_API_KEY_2=
OCTOPIN_GATEWAY=https://gateway.octopin.app/ipfs/

# Public site URL used in NFT metadata external_url (must be HTTPS in production).
MORROW_PUBLIC_URL=https://gno.land/
# Optional real project accounts. Leave blank to hide the footer icons rather than invent links.
MORROW_X_URL=
MORROW_GITHUB_URL=

# Written automatically by `npm run pin:octopin` after both directories are verified.
# The published drop is 1,000 editions = exactly 2,000 files (Octopin Free cap).
MOONBOUND_IMAGE_BASE_URI=
MOONBOUND_METADATA_BASE_URI=
MOONBOUND_COLLECTION_PATH=

# Optional comma-separated realm paths manually verified by the moderation team.
VERIFIED_COLLECTION_PATHS=
# Generate a long random token to protect /admin moderation endpoints.
MORROW_ADMIN_TOKEN=

# Optional PostgreSQL for persistent multi-instance deployments. Local JSON is used when blank.
DATABASE_URL=
PGSSL=false

# Octopin uploads for OWL COLLECTION, NEON SOULS and THE TREES:
# npm run pin:three-collections checks both account quotas, reduces supply if needed, pins all assets,
# then verifies every uploaded file by fetching it from the gateway and checking SHA-256.
# Never expose these keys to browser code or commit .env.

# Pinata for additional collections (server-side only). Never expose this JWT to the browser.
# PINATA_JWT=
# PINATA_GATEWAY=your-gateway.mypinata.cloud
